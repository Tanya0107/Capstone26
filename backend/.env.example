# LLM providers (see docs/DECISIONS.md D1, D2)
ANTHROPIC_API_KEY=
# Only needed when the Anthropic key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GENERATOR_MODEL=claude-sonnet-4-6
CRITIC_MODEL=gpt-4o
TUTOR_MODEL=claude-sonnet-4-6
TUTOR_FALLBACK_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=text-embedding-3-large

# Firebase Admin
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
USE_FIRESTORE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Pipeline budgets (NFR2)
GENERATION_TIMEOUT_SECONDS=900
TUTOR_TURN_TIMEOUT_SECONDS=15
MAX_CRITIC_REGENERATION_CYCLES=2

# CORS
FRONTEND_ORIGIN=http://localhost:3000
