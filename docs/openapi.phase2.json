                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": true,
                                    "type": "object",
                                    "title": "Response Healthz Healthz Get"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
