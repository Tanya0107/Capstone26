rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers (NFR4 Role Based Access Control) ----
    function isSignedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isTeacher() { return isSignedIn() && userDoc().data.role == "teacher"; }
    function isStudent() { return isSignedIn() && userDoc().data.role == "student"; }
    function sameSchool(schoolKey) { return userDoc().data.schoolKey == schoolKey; }

    // ---- Central Content Bank ----
    match /schools/{schoolId} {
      allow read: if isSignedIn() && sameSchool(schoolId);
      allow write: if false; // provisioned by admin script only
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow write: if false; // provisioned by admin script or Cloud Function only
    }

    match /curriculumModules/{moduleId} {
      // Teachers manage their own modules (FR5). Students read only modules
      // published to them. assignedStudentKeys is denormalized at publish
      // time because list queries must be provable from query filters alone,
      // a get() based rule would reject them. See docs/API_CONTRACT.md.
      allow read: if isTeacher()
        || (isStudent() && request.auth.uid in resource.data.assignedStudentKeys);
      allow create: if isTeacher()
        && request.resource.data.creatorTeacherKey == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.creatorTeacherKey == request.auth.uid
        && request.resource.data.creatorTeacherKey == request.auth.uid;
      allow delete: if isTeacher()
        && resource.data.creatorTeacherKey == request.auth.uid;
    }

    match /exercises/{exerciseId} {
      // Student safe fields only (prompt, order, scaffoldSteps). The answer
      // fields live in exerciseSolutions (R6). Audience array mirrors the
      // parent module and is written in the same publish batch.
      allow read: if isTeacher()
        || (isStudent() && request.auth.uid in resource.data.assignedStudentKeys);
      allow create, update, delete: if isTeacher();
    }

    match /exerciseSolutions/{solutionId} {
      // R6 answer protection. Never readable by students. The Socratic tutor
      // reads these server side through the Admin SDK.
      allow read: if isTeacher();
      allow create, update, delete: if isTeacher();
    }

    // ---- Distribution & Progress Bank ----
    match /assignments/{assignmentId} {
      allow read: if isTeacher()
        || (isStudent() && request.auth.uid in resource.data.assignedTo);
      allow create: if isTeacher()
        && request.resource.data.teacherKey == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.teacherKey == request.auth.uid;
      allow delete: if false;
    }

    match /studentProgress/{progressId} {
      allow read: if isTeacher() || (isStudent() && resource.data.studentKey == request.auth.uid);
      allow create, update: if isStudent() && request.resource.data.studentKey == request.auth.uid;
      allow delete: if false;
    }

    // ---- Logs & Analytics Bank (NFR5 no PII in telemetry payloads) ----
    match /telemetryEvents/{eventId} {
      allow read: if isTeacher();
      allow create: if isStudent() && request.resource.data.studentKey == request.auth.uid;
      allow update, delete: if false; // append only log
    }

    match /feedbackMemoryBank/{memoryId} {
      allow read, write: if false; // backend (Admin SDK) only
    }
  }
}
